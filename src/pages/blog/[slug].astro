---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getPosts } from '../../lib/content';
import { formatDate } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post.entry);
---

<BaseLayout
  title={post.title}
  description={post.entry.data.description}
  type="article"
>
  <article class="mx-auto max-w-3xl">
    <header class="mb-6">
      <h1
        data-pagefind-meta="title"
        class="text-3xl font-bold tracking-tight sm:text-4xl"
      >
        {post.title}
      </h1>
      <time
        datetime={post.date.toISOString()}
        class="mt-2 block text-sm text-slate-600 dark:text-slate-400"
      >
        {formatDate(post.date)}
      </time>
      <div class="mt-3">
        <TagList tags={post.tags} />
      </div>
      <div class="mt-5 h-1 w-12 rounded bg-accent-500"></div>
    </header>
    <div
      data-pagefind-body
      class="prose max-w-none break-words dark:prose-invert prose-img:h-auto prose-img:rounded-md prose-img:bg-white"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
