---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <article class="prose max-w-none dark:prose-invert">
    <h1 class="tracking-tight">About</h1>
    <div class="not-prose mb-6 h-1 w-12 rounded bg-accent-500"></div>
    <p>
      I'm Brett Slaski, a backend developer with over twenty years of
      experience. For the last several years I've been writing a GraphQL API
      with Node.js.
    </p>
    <p>This site is the home of my blog, which has been running since 2007.</p>
  </article>
</BaseLayout>
