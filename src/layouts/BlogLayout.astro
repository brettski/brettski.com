---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  heading?: string;
}
const { title, heading = title } = Astro.props;
---

<BaseLayout title={title}>
  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_16rem]">
    <div class="min-w-0">
      <h1 class="text-3xl font-bold tracking-tight">{heading}</h1>
      <div class="mt-2 mb-8 h-1 w-12 rounded bg-accent-500"></div>
      <slot />
    </div>
    <Sidebar />
  </div>
</BaseLayout>
