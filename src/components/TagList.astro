---
import { tagColor } from '../lib/tagColor';
import { tagUrl } from '../lib/urls';

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2 text-sm">
    {tags.map((t) => (
      <li>
        <a
          href={tagUrl(t)}
          class={`rounded-md px-2 py-0.5 font-medium transition-colors ${tagColor(t)}`}
        >
          {t}
        </a>
      </li>
    ))}
  </ul>
)}
