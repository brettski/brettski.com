---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  width="28"
  height="28"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" class="fill-accent-600" />
  <rect x="9" y="6" width="4" height="20" rx="2" class="fill-white" />
  <circle
    cx="18"
    cy="18"
    r="5.5"
    fill="none"
    stroke-width="4"
    class="stroke-white"
  />
</svg>
