---
import { getPosts } from '../lib/content';
import { buildArchive } from '../lib/archive';
import { countTags } from '../lib/tags';
import { tagColor } from '../lib/tagColor';
import { monthUrl, tagUrl, yearUrl } from '../lib/urls';

const posts = await getPosts();
const archive = buildArchive(posts);
const tags = countTags(posts);
const monthName = (m: number) =>
  new Date(Date.UTC(2000, m - 1, 1)).toLocaleString('en-US', {
    month: 'long',
    timeZone: 'UTC',
  });
const heading =
  'mb-3 text-xs font-semibold uppercase tracking-widest text-accent-800 dark:text-accent-300';
const link =
  'text-slate-800 hover:text-accent-700 hover:underline dark:text-slate-200 dark:hover:text-accent-400';
---

<aside class="space-y-8 text-sm">
  <section
    aria-labelledby="archive-h"
    class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 id="archive-h" class={heading}>
      Archive
    </h2>
    <ul class="space-y-1">
      {archive.map((y) => (
        <li>
          <details>
            <summary class="cursor-pointer">
              <a href={yearUrl(y.year)} class={link}>
                {y.year}
              </a>{' '}
              <span class="text-slate-600 dark:text-slate-400">
                ({y.count})
              </span>
            </summary>
            <ul class="mt-1 ml-4 space-y-1">
              {y.months.map((m) => (
                <li>
                  <a href={monthUrl(y.year, m.month)} class={link}>
                    {monthName(m.month)}
                  </a>{' '}
                  <span class="text-slate-600 dark:text-slate-400">
                    ({m.count})
                  </span>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </section>
  <section
    aria-labelledby="tags-h"
    class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 id="tags-h" class={heading}>
      Tags
    </h2>
    <ul class="flex flex-wrap gap-1.5">
      {tags.map((t) => (
        <li>
          <a
            href={tagUrl(t.tag)}
            class={`inline-block rounded-md px-1.5 py-0.5 text-xs font-medium transition-colors ${tagColor(t.tag)}`}
          >
            {t.tag}
            <span class="ml-1 font-normal">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</aside>
