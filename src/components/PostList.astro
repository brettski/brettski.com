---
import type { Post } from '../lib/content';
import { formatDate } from '../lib/posts';
import { postUrl } from '../lib/urls';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p>No posts.</p>
) : (
  <ul class="space-y-4">
    {posts.map((p) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:border-accent-400 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-accent-600">
        <h2 class="text-xl font-semibold tracking-tight">
          <a
            href={postUrl(p.slug)}
            class="text-slate-900 hover:text-accent-700 dark:text-slate-100 dark:hover:text-accent-400"
          >
            {p.title}
          </a>
        </h2>
        <time
          datetime={p.date.toISOString()}
          class="text-sm text-slate-600 dark:text-slate-400"
        >
          {formatDate(p.date)}
        </time>
        <div class="mt-2">
          <TagList tags={p.tags} />
        </div>
      </li>
    ))}
  </ul>
)}
