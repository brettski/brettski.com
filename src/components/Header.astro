---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/search/', label: 'Search' },
];
const path = Astro.url.pathname;
---

<header class="border-b border-accent-200 bg-accent-50 dark:border-accent-800 dark:bg-accent-950">
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3"
    aria-label="Main"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-xl font-bold tracking-tight text-accent-800 dark:text-accent-300"
    >
      <Logo />
      brettski.com
    </a>
    <div class="flex items-center gap-2">
      <ul class="flex gap-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={path.startsWith(l.href) ? 'page' : undefined}
              class="rounded-md px-3 py-1.5 text-slate-700 hover:bg-accent-100 hover:text-accent-800 aria-[current=page]:font-semibold aria-[current=page]:text-accent-700 aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8 dark:text-slate-200 dark:hover:bg-accent-900 dark:hover:text-accent-300 dark:aria-[current=page]:text-accent-400"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
