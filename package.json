{
  "name": "brettski-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run index:dev && astro dev",
    "build": "astro build && tsx scripts/write-redirects.ts && pagefind --site dist",
    "preview": "wrangler dev",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "astro check",
    "test": "vitest run",
    "index:dev": "astro build --outDir .dev-index && pagefind --site .dev-index"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prismjs": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  }
}
